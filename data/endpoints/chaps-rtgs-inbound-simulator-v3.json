            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInboundInstitutionPaymentDtoV3"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInboundInstitutionPaymentDtoV3"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInboundInstitutionPaymentDtoV3"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
