          "bic": {
            "description": "BIC of the intermediary agent",
            "type": "string",
            "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$",
            "example": "BARCGB22XXX"
          },
          "lei": {
            "description": "Legal Entity Identifier of the agent",
            "type": "string",
